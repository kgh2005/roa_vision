<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>vision_tensorrt</name>
  <version>0.1.0</version>

  <description>
    TensorRT-accelerated YOLO detection node for the RO:BIT vision pipeline.
  </description>

  <maintainer email="robit@todo.todo">
    robit
  </maintainer>

  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>vision_interfaces</depend>

  <!-- OpenCV: core, imgproc, highgui -->
  <depend>libopencv-dev</depend>

  <!-- Launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- debug.launch.py에서 ZED 노드를 실행할 경우에만 필요 -->
  <exec_depend>zed_wrapper</exec_depend>

  <!-- Tests -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
